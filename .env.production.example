# Copy to .env (or provide these in your deployment environment) and replace every placeholder.
APP_NAME=Todo
APP_URL=https://todo.example.com
HTTP_PORT=80

MYSQL_DATABASE=todo
MYSQL_USER=todo_app
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# phpMyAdmin is available only with the admin profile and on localhost.
PHPMYADMIN_PORT=8080
PHPMYADMIN_UPLOAD_LIMIT=16M
